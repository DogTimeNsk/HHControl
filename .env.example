# OAuth application settings registered at https://dev.hh.ru
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_OAUTH_REDIRECT_URI=https://example.org/hh/redirect
HH_USER_AGENT=HH-Control/0.1 (your-email@example.com)

# Generate with: openssl rand -hex 32
APP_SESSION_SECRET=change-this-to-a-long-random-value
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite+aiosqlite:////data/hh-control.db
SCHEDULER_INTERVAL_HOURS=4
COOKIE_SECURE=false

# Host binding for the frontend Nginx container. Keep loopback in production.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
