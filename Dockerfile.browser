# syntax=docker/dockerfile:1.7
FROM mcr.microsoft.com/playwright/python:v1.57.0-noble
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    pip install --no-cache-dir uv && \
    uv export --frozen --no-dev --no-emit-project -o requirements.txt && \
    uv pip install --system -r requirements.txt && \
    apt-get update && apt-get install -y --no-install-recommends xvfb fluxbox x11vnc novnc websockify && \
    rm -rf /var/lib/apt/lists/*
COPY backend/ ./
RUN uv pip install --system --no-deps .
COPY docker/browser-entrypoint.sh /browser-entrypoint.sh
RUN chmod +x /browser-entrypoint.sh
CMD ["/browser-entrypoint.sh"]
